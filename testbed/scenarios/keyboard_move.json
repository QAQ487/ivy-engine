{
  "version": 1,
  "name": "keyboard-move",
  "scene": "rom/scene/scene_runtime_bridge_player.json",
  "timeoutSec": 120,
  "steps": [
    { "type": "comment", "text": "Port of phase4 W-walk: inject W and assert Player position changes." },
    { "type": "wait_ready", "timeoutSec": 25 },
    { "type": "observe", "object": "Player" },
    {
      "type": "assert",
      "target": "Player.position.x",
      "op": "approx",
      "value": 0.0,
      "tol": 0.25
    },
    {
      "type": "assert",
      "target": "Player.position.y",
      "op": "approx",
      "value": 1.0,
      "tol": 0.35
    },
    {
      "type": "keyboard",
      "keys": ["W"],
      "updates": 120
    },
    { "type": "observe", "object": "Player" },
    {
      "type": "assert",
      "target": "Player.position",
      "op": "changed"
    },
    {
      "type": "assert",
      "target": "Player.position.y",
      "op": "approx",
      "value": 1.0,
      "tol": 0.35
    }
  ]
}
