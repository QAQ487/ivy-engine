{
  "nodes": [
    {
      "id": "file:engine/scripting/script_component.cpp",
      "type": "file",
      "name": "script_component.cpp",
      "filePath": "engine/scripting/script_component.cpp",
      "summary": "Implements ScriptComponent lifecycle, JSON serialization of script overrides, factory-backed instantiation, and DLL hot-reload teardown.",
      "tags": ["scripting", "component", "serialization", "lifecycle", "hot-reload"],
      "complexity": "moderate",
      "languageNotes": "Defers Script::OnCreate until the first play-mode Update so editor preview does not run game-side spawn logic."
    },
    {
      "id": "file:engine/scripting/script_component.h",
      "type": "file",
      "name": "script_component.h",
      "filePath": "engine/scripting/script_component.h",
      "summary": "Declares ScriptComponent, the ECS Component that wraps a Script subclass selected by scriptClass from prefab JSON.",
      "tags": ["component", "data-model", "scripting", "type-definition"],
      "complexity": "moderate"
    },
    {
      "id": "file:engine/scripting/script_factory.h",
      "type": "file",
      "name": "script_factory.h",
      "filePath": "engine/scripting/script_factory.h",
      "summary": "Declares the ScriptFactory singleton that maps script class names to creators and manages Windows DLL load, unload, and hot-reload.",
      "tags": ["factory", "singleton", "scripting", "hot-reload"],
      "complexity": "moderate",
      "languageNotes": "Uses unique_ptr with a custom deleter so DLL-allocated Script instances can be destroyed with the matching module."
    },
    {
      "id": "file:engine/scripting/script_register.h",
      "type": "file",
      "name": "script_register.h",
      "filePath": "engine/scripting/script_register.h",
      "summary": "Provides the REGISTER_SCRIPT macro that self-registers a Script subclass with ScriptFactory at static-initialization time.",
      "tags": ["factory", "scripting", "registration", "macro"],
      "complexity": "simple",
      "languageNotes": "Static-init registrator pattern avoids a centralized script registration list."
    },
    {
      "id": "file:src/app/rendering/scene_transition.cpp",
      "type": "file",
      "name": "scene_transition.cpp",
      "filePath": "src/app/rendering/scene_transition.cpp",
      "summary": "Forwards scene-transition initialize, update, draw, and load-request APIs to matching exports on loaded script DLLs.",
      "tags": ["scripting", "service", "scene", "rendering"],
      "complexity": "moderate",
      "languageNotes": "Thin C ABI shim: each public function resolves a like-named DLL export via ScriptFactory::ResolveDllExport."
    },
